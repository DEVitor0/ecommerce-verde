  "description": "Loja virtual Jardim Exótico — Next.js, TypeScript, Redux Toolkit e Jest.",
  "author": "Vitor Moreira",
  "license": "ISC",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
